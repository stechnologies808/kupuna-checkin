# Copy to .env and fill in. Never share or commit .env.

# Leave DRY_RUN=1 to test without Twilio. Set to 0 to place real calls and texts.
DRY_RUN=1

# Password for the /admin status page (any username works)
ADMIN_PASSWORD=

# From console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public https address Twilio uses to reach this app (ngrok while testing, your host later)
PUBLIC_BASE_URL=http://localhost:5000

SERVICE_NAME=Kupuna Check-In
TIMEZONE=Pacific/Honolulu

# Optional timing rules (minutes unless noted)
# MAX_TRIES=3
# RETRY_GAP_MIN=5
# FAMILY_REPLY_WINDOW_MIN=15
# QUIET_BEFORE_HOUR=7
# QUIET_AFTER_HOUR=21
# WEEKLY_SUMMARY_WEEKDAY=6   (Monday=0 ... Sunday=6)
# WEEKLY_SUMMARY_HOUR=18

# Sign-up page (optional)
# OWNER_PHONE=+1808...                       you get a text for each new sign-up
# PAYMENT_LINK_BASIC=https://buy.stripe.com/...       shown after sign-up
# PAYMENT_LINK_TALK_STORY=https://buy.stripe.com/...
# PRICE_BASIC=$12/month
# PRICE_TALK_STORY=$39/month
# FREE_TRIAL_NOTE=First month free while we're getting started.   (set empty to hide)
